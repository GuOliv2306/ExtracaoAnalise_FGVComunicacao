   "source": [
    "# Faz a limpa e pega as hashtags mais citadas\n",
    "df = pd.read_csv('tktk_base1.csv')\n",
    "hashtags = df['textExtra'].dropna().apply(lambda x: [tag['hashtagName'] for tag in eval(x) if tag['hashtagName']]).explode()\n",
    "# Conta as ocorrências de cada hashtag e pega as 100 principais\n",
    "top_hashtags = hashtags.value_counts().head(100)\n",
    "# Cria o df com base nos top hashtags\n",
    "df = pd.DataFrame({'top_hashtags': top_hashtags})\n",
    "df"
   ]
